{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modoitaliano.fm/schemas/social-image-input-v1.schema.json",
  "title": "ModoItaliano social image input",
  "type": "object",
  "additionalProperties": false,
  "required": ["imageUrl", "categoryName", "title", "qrCodeHtml"],
  "properties": {
    "imageUrl": { "type": "string", "format": "uri" },
    "categoryName": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "qrCodeHtml": { "type": "string", "minLength": 1 }
  }
}
