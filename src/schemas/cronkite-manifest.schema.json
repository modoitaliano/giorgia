{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cronkite.invalid/schemas/template-manifest-v1.schema.json",
  "title": "Cronkite declarative template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "version", "templateRendering"],
  "properties": {
    "package": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "templateRendering": { "$ref": "#/$defs/templateRendering" }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000\\r\\n]).+$"
    },
    "templateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "partials"],
      "properties": {
        "entry": { "$ref": "#/$defs/safePath" },
        "partials": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "partial": { "$ref": "#/$defs/templateReference" },
    "helperConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteName", "defaultLanguage", "supportedLanguages", "prefixDefaultLocale", "dateLocale", "timeZone", "homepageTitles", "layoutTitleFallbacks", "titleSeparator", "defaultSocialImageUrl"],
      "properties": {
        "siteName": { "type": "string", "minLength": 1 },
        "defaultLanguage": { "type": "string", "minLength": 1 },
        "supportedLanguages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "prefixDefaultLocale": { "type": "boolean" },
        "dateLocale": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "homepageTitles": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "layoutTitleFallbacks": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "titleSeparator": { "type": "string" },
        "defaultSocialImageUrl": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "embedParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "integer"] },
        "pattern": { "type": "string" },
        "enum": { "type": "array", "minItems": 1 },
        "default": { "type": ["string", "integer"] },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    },
    "embed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urlTemplate", "parameters"],
      "properties": {
        "urlTemplate": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/embedParameter" } }
      }
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "width", "height"],
      "properties": {
        "format": { "enum": ["png", "jpeg", "webp"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "renderable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "inputSchema", "contentType"],
      "properties": {
        "template": { "$ref": "#/$defs/templateReference" },
        "inputSchema": { "$ref": "#/$defs/safePath" },
        "contentType": { "type": "string", "minLength": 1 },
        "raster": { "$ref": "#/$defs/raster" }
      }
    },
    "staticAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "contentType", "cacheControl"],
      "properties": {
        "source": { "$ref": "#/$defs/safePath" },
        "contentType": { "type": "string", "minLength": 1 },
        "cacheControl": { "type": "string", "minLength": 1 }
      }
    },
    "systemVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "document"],
      "properties": {
        "key": { "$ref": "#/$defs/safePath" },
        "document": { "type": "object" }
      }
    },
    "systemPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderable", "contentType", "cacheControl", "variants"],
      "properties": {
        "renderable": { "type": "string", "minLength": 1 },
        "contentType": { "type": "string", "minLength": 1 },
        "cacheControl": { "type": "string", "minLength": 1 },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/systemVariant" } }
      }
    },
    "templateRendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contractVersion", "partials", "helperConfig", "embedRegistry", "renderables", "staticAssets", "systemPages"],
      "properties": {
        "contract": { "const": "cronkite.templates" },
        "contractVersion": { "const": 1 },
        "partials": { "type": "object", "additionalProperties": { "$ref": "#/$defs/partial" } },
        "helperConfig": { "$ref": "#/$defs/helperConfig" },
        "embedRegistry": { "type": "object", "additionalProperties": { "$ref": "#/$defs/embed" } },
        "renderables": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/renderable" } },
        "staticAssets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/staticAsset" } },
        "systemPages": { "type": "array", "items": { "$ref": "#/$defs/systemPage" } }
      }
    }
  }
}
