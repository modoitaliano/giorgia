<!doctype html>
<html lang='{{language}}'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover' />
    <title>{{#if seo.metaTitle}}{{seo.metaTitle}}{{else}}{{title}} | fifthbell{{/if}}</title>
    <meta name='description' content='{{#if seo.metaDescription}}{{seo.metaDescription}}{{else}}{{excerpt}}{{/if}}' />
    <meta property='og:title' content='{{#if seo.metaTitle}}{{seo.metaTitle}}{{else}}{{title}} | fifthbell{{/if}}' />
    <meta property='og:description' content='{{#if seo.metaDescription}}{{seo.metaDescription}}{{else}}{{excerpt}}{{/if}}' />
    {{#if seo.ogImage}}<meta property='og:image' content='{{seo.ogImage}}' />{{/if}}
    <meta property='og:type' content='website' />
    <meta property='og:url' content='{{canonicalUrl}}' />
    <link href="https://cdn.fifthbell.com/content/fonts/fonts.css" rel="stylesheet">
    <style>
      :root {
        --bg: #000000;
        --surface: rgba(0, 0, 0, 0.70);
        --text: #ffffff;
        --muted: #9ca3af;
        --accent: #b21100;
        --radius: 0;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: 'Encode Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100dvh;
      }
      .wrap {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 0 16px 32px;
      }
      .header-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 0 32px;
      }
      .logo-box {
        background: var(--accent);
        color: #fff;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(178, 17, 0, 0.5);
        margin-bottom: 24px;
      }
      .logo-icon { width: 32px; height: 32px; }
      h1 {
        font-family: 'Encode Sans Condensed', sans-serif;
        margin: 0 0 8px;
        text-align: center;
        font-size: 36px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        line-height: 1.1;
      }
      .sub {
        margin: 0;
        text-align: center;
        color: var(--muted);
        font-size: 16px;
        font-weight: 400;
        max-width: 80%;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      .card {
        display: block;
        text-decoration: none;
        color: inherit;
        background: #111;
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        aspect-ratio: 1 / 1;
      }
      .card:nth-child(5n + 1) {
        grid-column: span 2;
        aspect-ratio: 2.1 / 1;
      }
      .card:nth-child(5n + 1) .card-main {
        padding: 16px 20px;
      }
      .card:nth-child(5n + 1) .title {
        font-size: 18px;
        line-height: 1.25;
        -webkit-line-clamp: 2;
      }
      .card:nth-child(5n + 1) .category-label {
        font-size: 12px;
      }
      .card:nth-child(5n + 1) .accent-bar {
        width: 32px;
      }
      .card-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .card-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.85;
        transition: opacity 0.3s ease, transform 0.6s ease;
      }
      .card:hover .card-bg img {
        opacity: 1;
        transform: scale(1.05);
      }
      .card-content {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        z-index: 10;
      }
      .card-header {
        display: inline-flex;
        align-items: center;
        background-color: var(--surface);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 4px 8px;
        box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.3);
      }
      .category-label {
        font-family: 'Encode Sans Condensed', sans-serif;
        font-size: 10px;
        font-weight: 700;
        color: #ffffff;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .card-main {
        background-color: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 12px;
      }
      .accent-bar {
        width: 24px;
        height: 3px;
        background-color: var(--accent);
        margin-bottom: 8px;
      }
      .title {
        font-family: 'Encode Sans', sans-serif;
        font-size: 13px;
        line-height: 1.3;
        font-weight: 700;
        color: #ffffff;
        text-wrap: balance;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .footer {
        margin-top: 40px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-family: 'Encode Sans Condensed', sans-serif;
      }
    </style>
  </head>
  <body>
    <main class='wrap'>
      <div class='header-area'>
        <div class='logo-box' aria-label='fifthbell'>
          <svg class='logo-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M10.268 21a2 2 0 0 0 3.464 0'></path><path d='M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326'></path><path d='M4 2C2.8 3.7 2 5.7 2 8'></path><path d='M22 8a10 10 0 0 0-2-6'></path></svg>
        </div>
        <h1>{{title}}</h1>
        {{#if excerpt}}<p class='sub'>{{excerpt}}</p>{{/if}}
      </div>
      
      <section class='grid'>
        {{#each articles}}
          <a class='card' href='{{url}}' aria-label='Read article: {{title}}'>
            {{#if featuredImage.url}}
              <div class='card-bg'>
                <img src='{{featuredImage.url}}' alt='{{#if featuredImage.alt}}{{featuredImage.alt}}{{else}}{{title}}{{/if}}' loading='lazy' />
              </div>
            {{/if}}
            
            <div class='card-content'>
              {{#if categories.[0]}}
                <div class='card-header'>
                  <span class='category-label'>{{categories.[0].name}}</span>
                </div>
              {{else}}
                <div class='card-header'>
                  <span class='category-label'>LATEST</span>
                </div>
              {{/if}}
              <div class='card-main'>
                <div class='accent-bar'></div>
                <div class='title'>{{title}}</div>
              </div>
            </div>
          </a>
        {{/each}}
      </section>
      
      <div class='footer'>Updated {{formatDate updatedAt}}</div>
    </main>
  </body>
</html>
