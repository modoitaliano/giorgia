<blockquote class='border-l-4 border-[#b21100] pl-4 py-2 my-8'>
  <p class='text-2xl font-serif text-slate-900 dark:text-slate-100 leading-relaxed'>{{text}}</p>
  {{#if attribution}}
    <cite class='block mt-2 text-sm text-slate-500 dark:text-slate-400 not-italic'>{{attribution}}</cite>
  {{/if}}
</blockquote>
