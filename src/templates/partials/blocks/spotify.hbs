<figure class='my-8 w-full'>
  <div class='overflow-hidden w-full rounded-sm bg-slate-100 dark:bg-slate-900'>
    <iframe
      class='w-full min-h-[352px]'
      src='{{spotifyEmbedUrl url}}'
      title='Reproductor de Spotify'
      loading='lazy'
      allow='autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'
    ></iframe>
  </div>
  <figcaption class='text-sm text-slate-500 dark:text-slate-400 mt-2'>
    <a href='{{url}}' target='_blank' rel='noopener noreferrer' class='hover:underline'>Open on Spotify</a>
  </figcaption>
</figure>
