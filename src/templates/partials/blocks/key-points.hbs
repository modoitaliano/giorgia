<section class='my-8 border border-slate-200 dark:border-slate-800 p-4'>
  <h4 class='text-sm uppercase tracking-wider font-bold text-[#8f0d00] dark:text-[#ff2e1a] mb-3'>{{title}}</h4>
  <ul class='list-disc pl-5 space-y-2 text-slate-800 dark:text-slate-200'>
    {{#each points}}
      <li>{{this}}</li>
    {{/each}}
  </ul>
</section>
