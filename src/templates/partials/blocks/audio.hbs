<figure class='my-8'>
  {{#if title}}
    <figcaption class='text-sm font-bold text-slate-700 dark:text-slate-300 mb-2'>{{title}}</figcaption>
  {{/if}}
  <audio controls preload='none' class='w-full'>
    <source src='{{url}}' />
    Your browser does not support the audio element.
  </audio>
  {{#if caption}}
    <p class='text-sm text-slate-500 dark:text-slate-400 mt-2'>{{caption}}</p>
  {{/if}}
</figure>
