{{#if ordered}}
  <ol class='my-6 list-decimal pl-6 text-slate-800 dark:text-slate-200 space-y-2'>
    {{#each items}}
      <li>{{this}}</li>
    {{/each}}
  </ol>
{{else}}
  <ul class='my-6 list-disc pl-6 text-slate-800 dark:text-slate-200 space-y-2'>
    {{#each items}}
      <li>{{this}}</li>
    {{/each}}
  </ul>
{{/if}}
