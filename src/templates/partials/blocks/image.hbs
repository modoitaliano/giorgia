<figure class='my-8'>
  <img src='{{this.url}}' alt='{{alt}}' class='w-full h-auto object-cover'{{#if this.variants}} srcset='{{#each this.variants}}{{url}} {{width}}w{{#unless @last}}, {{/unless}}{{/each}}{{#if this.width}}, {{this.url}} {{this.width}}w{{/if}}' sizes='(min-width: 1024px) 66vw, 100vw'{{/if}}{{#if this.width}}{{#if this.height}} width='{{this.width}}' height='{{this.height}}'{{/if}}{{/if}} loading='lazy' />
  {{#if caption}}
    <figcaption class='text-sm text-slate-500 dark:text-slate-400 mt-2'>{{caption}}</figcaption>
  {{/if}}
</figure>
