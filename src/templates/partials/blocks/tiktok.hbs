<figure class='my-8 w-full'>
  <div class='overflow-hidden w-full'>
    <iframe
      class='w-full min-h-[740px]'
      src='{{tiktokEmbedUrl url}}'
      title='TikTok post'
      loading='lazy'
      allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      sandbox='allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin'
    ></iframe>
  </div>
  <figcaption class='text-sm text-slate-500 dark:text-slate-400 mt-2'>
    <a href='{{url}}' target='_blank' rel='noopener noreferrer' class='hover:underline'>View post on TikTok</a>
  </figcaption>
</figure>
