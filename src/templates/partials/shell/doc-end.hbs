      {{> components/stream-player}}
    </div>
    <script>
      (function () {
        function initStreamPlayer(root) {
          if (!(root instanceof HTMLElement) || root.dataset.streamPlayerBound === 'true') return;

          var audio = root.querySelector('[data-stream-audio]');
          var title = root.querySelector('[data-stream-title]');
          var artist = root.querySelector('[data-stream-artist]');
          var status = root.querySelector('[data-stream-status]');
          var volume = root.querySelector('[data-stream-volume]');
          var toggles = document.querySelectorAll('[data-stream-toggle]');
          if (!(audio instanceof HTMLAudioElement) || !(title instanceof HTMLElement) || !(artist instanceof HTMLElement) || !(status instanceof HTMLElement) || !(volume instanceof HTMLInputElement)) return;

          var playIconPath = 'M8 5.5a1 1 0 0 1 1.52-.86l9 6.5a1 1 0 0 1 0 1.72l-9 6.5A1 1 0 0 1 8 18.5v-13Z';
          var pauseIconPath = 'M7 5h4v14H7zM13 5h4v14h-4z';
          var nowPlaying = window.__brokawNowPlaying || null;
          var hasStartedPlayback = false;
          var desiredVolume = Number(volume.value);

          function setControls(isPlaying) {
            toggles.forEach(function (toggle) {
              if (!(toggle instanceof HTMLButtonElement)) return;
              toggle.setAttribute('aria-pressed', String(isPlaying));
              toggle.setAttribute('aria-label', isPlaying ? 'Pausar ModoItaliano FM' : 'Reproducir ModoItaliano FM');
              var icon = toggle.querySelector('[data-stream-icon]');
              if (icon instanceof SVGPathElement) icon.setAttribute('d', isPlaying ? pauseIconPath : playIconPath);
            });
          }

          function setMessage(nextTitle, nextStatus) {
            title.textContent = nextTitle;
            status.textContent = nextStatus;
          }

          function setNowPlaying(item) {
            if (!item || typeof item !== 'object') return;

            nowPlaying = item;
            var nextTitle = typeof item.title === 'string' && item.title.trim() ? item.title.trim() : 'ModoItaliano FM';
            var nextArtist = typeof item.artist === 'string' && item.artist.trim() ? item.artist.trim() : 'La música que nos une';
            title.textContent = nextTitle;
            artist.textContent = nextArtist;
            status.textContent = item.isPlaceholder === true ? 'En directo' : 'Reproduciendo';
          }

          function setPlaying() {
            hasStartedPlayback = true;
            root.hidden = false;
            setControls(true);
            if (nowPlaying) {
              setNowPlaying(nowPlaying);
            } else {
              setMessage('ModoItaliano FM', 'En directo');
            }
          }

          function setPaused() {
            hasStartedPlayback = false;
            root.hidden = true;
            setControls(false);
          }

          function getVolumeValue() {
            var nextVolume = Number(volume.value);
            if (!Number.isFinite(nextVolume)) return 0.85;
            return Math.max(0, Math.min(1, nextVolume));
          }

          function applyVolume() {
            audio.muted = desiredVolume <= 0;
            audio.volume = desiredVolume;
          }

          async function togglePlayback() {
            if (audio.paused) {
              setControls(true);
              setMessage('Conectando…', 'Abriendo transmisión');
              applyVolume();
              try {
                await audio.play();
              } catch (_error) {
                root.hidden = true;
                setControls(false);
                setMessage('No disponible', 'Inténtalo de nuevo');
              }
            } else {
              audio.pause();
            }
          }

          applyVolume();
          toggles.forEach(function (toggle) {
            if (toggle instanceof HTMLButtonElement) toggle.addEventListener('click', togglePlayback);
          });
          volume.addEventListener('input', function () {
            desiredVolume = getVolumeValue();
            applyVolume();
          });
          audio.addEventListener('play', setPlaying);
          audio.addEventListener('playing', setPlaying);
          audio.addEventListener('pause', setPaused);
          audio.addEventListener('waiting', function () {
            if (!hasStartedPlayback) setMessage('Conectando…', 'Abriendo transmisión');
          });
          audio.addEventListener('error', function () {
            root.hidden = true;
            setControls(false);
            setMessage('No disponible', 'Inténtalo de nuevo');
          });
          document.addEventListener('brokaw:now-playing', function (event) {
            setNowPlaying(event.detail);
          });
          if (nowPlaying) setNowPlaying(nowPlaying);

          root.dataset.streamPlayerBound = 'true';
        }

        function initAllStreamPlayers() {
          document.querySelectorAll('[data-stream-player]').forEach(initStreamPlayer);
        }

        window.__brokawInitStreamPlayers = initAllStreamPlayers;
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAllStreamPlayers);
        } else {
          initAllStreamPlayers();
        }
      })();
    </script>
    <script>
      (function () {
        function getLocale() {
          var lang = document.documentElement.getAttribute('lang') || 'en';
          if (lang === 'es') return 'es';
          if (lang === 'it') return 'it';
          return 'en';
        }

        function formatRelativeTimestamp(isoString) {
          if (!isoString) return '';

          var date = new Date(isoString);
          if (Number.isNaN(date.getTime())) return '';

          var locale = getLocale();
          var rtf = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' });
          var diffMs = Date.now() - date.getTime();
          var diffMinutes = Math.max(1, Math.floor(diffMs / 60000));

          if (diffMinutes < 60) {
            return rtf.format(-diffMinutes, 'minute');
          }

          var diffHours = Math.max(1, Math.floor(diffMinutes / 60));
          if (diffHours < 24) {
            return rtf.format(-diffHours, 'hour');
          }

          var diffDays = Math.max(1, Math.floor(diffHours / 24));
          return rtf.format(-diffDays, 'day');
        }

        function hydrateRelativeTimes(root) {
          var scope = root || document;
          var timestamps = scope.querySelectorAll('.article-time[data-timestamp]');

          timestamps.forEach(function (node) {
            var isoString = node.getAttribute('data-timestamp');
            var formatted = formatRelativeTimestamp(isoString);
            if (formatted) {
              node.textContent = formatted;
            }
          });
        }

        window.__brokawHydrateRelativeTimes = hydrateRelativeTimes;

        function initRelativeTimes() {
          hydrateRelativeTimes(document);
          window.setInterval(function () {
            hydrateRelativeTimes(document);
          }, 60000);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initRelativeTimes);
        } else {
          initRelativeTimes();
        }
      })();
    </script>
    <script>
      (function () {
        function setSlideState(slides, dots, index) {
          slides.forEach(function (slide, slideIndex) {
            var active = slideIndex === index;
            var wasActive = slide.classList.contains('active');

            if (active) {
              slide.classList.remove('hidden');
              slide.classList.add('active');
              slide.classList.remove('pointer-events-none');

              if (!wasActive) {
                slide.classList.remove('opacity-100');
                slide.classList.add('opacity-0');
                window.requestAnimationFrame(function () {
                  slide.classList.remove('opacity-0');
                  slide.classList.add('opacity-100');
                });
              } else {
                slide.classList.remove('opacity-0');
                slide.classList.add('opacity-100');
              }
            } else {
              slide.classList.remove('active');
              slide.classList.remove('opacity-100');
              slide.classList.add('opacity-0');
              slide.classList.add('hidden');
              slide.classList.add('pointer-events-none');
            }
          });
          dots.forEach(function (dot, dotIndex) {
            dot.classList.toggle('active', dotIndex === index);
          });
        }

        function initCarousels(root) {
          var scopes = (root || document).querySelectorAll('[data-carousel]');
          scopes.forEach(function (scope) {
            if (scope.dataset.carouselBound === 'true') return;

            var slides = Array.prototype.slice.call(scope.querySelectorAll('.carousel-slide'));
            if (slides.length === 0) {
              scope.dataset.carouselBound = 'true';
              return;
            }

            var dots = Array.prototype.slice.call(scope.querySelectorAll('.carousel-dot'));
            var nextButton = scope.querySelector('.carousel-next');
            var activeIndex = slides.findIndex(function (slide) {
              return slide.classList.contains('active');
            });
            var currentIndex = activeIndex >= 0 ? activeIndex : 0;
            var timer = null;

            function clearTimer() {
              if (timer === null) return;
              window.clearInterval(timer);
              timer = null;
            }

            function startTimer() {
              clearTimer();
              if (slides.length < 2) return;

              timer = window.setInterval(function () {
                if (!document.contains(scope)) {
                  clearTimer();
                  return;
                }
                currentIndex = (currentIndex + 1) % slides.length;
                setSlideState(slides, dots, currentIndex);
              }, 6000);
            }

            function goToSlide(nextIndex) {
              currentIndex = nextIndex;
              setSlideState(slides, dots, currentIndex);
              startTimer();
            }

            dots.forEach(function (dot, dotIndex) {
              dot.addEventListener('click', function () {
                goToSlide(dotIndex);
              });
            });

            if (nextButton) {
              nextButton.addEventListener('click', function () {
                goToSlide((currentIndex + 1) % slides.length);
              });
            }

            scope.addEventListener('mouseenter', clearTimer);
            scope.addEventListener('mouseleave', startTimer);

            setSlideState(slides, dots, currentIndex);
            startTimer();
            scope.dataset.carouselBound = 'true';
          });
        }

        window.__brokawInitCarousels = initCarousels;
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            initCarousels(document);
          });
        } else {
          initCarousels(document);
        }
      })();
    </script>
    <script>
      (function () {
        var WIDGET_HOST = 'widgets.sofascore.com';
        var WIDGET_PATH = '/embed/attackMomentum';

        function getWidgetTheme() {
          return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        }

        function updateSofascoreIframe(iframe, theme) {
          if (!(iframe instanceof HTMLIFrameElement)) return;
          var src = iframe.getAttribute('src');
          if (!src) return;

          try {
            var url = new URL(src, window.location.origin);
            if (url.hostname !== WIDGET_HOST) return;
            if (!url.pathname.includes(WIDGET_PATH)) return;

            if (url.searchParams.get('widgetTheme') === theme) return;

            url.searchParams.set('widgetTheme', theme);
            iframe.setAttribute('src', url.toString());
          } catch (_error) {
            // Ignore malformed iframe src values.
          }
        }

        function syncSofascoreTheme() {
          var theme = getWidgetTheme();
          var iframes = document.querySelectorAll('iframe[src*="widgets.sofascore.com/embed/attackMomentum"]');
          iframes.forEach(function (iframe) {
            updateSofascoreIframe(iframe, theme);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncSofascoreTheme);
        } else {
          syncSofascoreTheme();
        }

        var observer = new MutationObserver(function () {
          syncSofascoreTheme();
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>
    <script>
      (function () {
        function initNowPlaying(root) {
          if (!(root instanceof HTMLElement) || root.dataset.nowPlayingBound === 'true') return;

          var endpoint = root.dataset.nowPlayingEndpoint;
          var artwork = root.querySelector('[data-now-playing-artwork]');
          var brand = root.querySelector('[data-now-playing-brand]');
          var status = root.querySelector('[data-now-playing-status]');
          var title = root.querySelector('[data-now-playing-title]');
          var artist = root.querySelector('[data-now-playing-artist]');
          if (!endpoint || !(artwork instanceof HTMLImageElement) || !(brand instanceof HTMLElement) || !(status instanceof HTMLElement) || !(title instanceof HTMLElement) || !(artist instanceof HTMLElement)) return;

          var fallback = {
            title: (title.textContent || '').trim() || 'ModoItaliano',
            artist: (artist.textContent || '').trim() || 'Radio en vivo',
            isPlaceholder: true
          };

          function setText(element, value, fallbackValue) {
            element.textContent = typeof value === 'string' && value.trim() ? value.trim() : fallbackValue;
          }

          function showBrand() {
            brand.classList.remove('hidden');
            artwork.classList.add('hidden');
            artwork.removeAttribute('src');
            artwork.alt = '';
          }

          function showArtwork(url, itemTitle, itemArtist) {
            artwork.src = url;
            artwork.alt = [itemTitle, itemArtist].filter(Boolean).join(' by ');
            artwork.classList.remove('hidden');
            brand.classList.add('hidden');
          }

          function applyNowPlaying(item) {
            var displayTitle = typeof item.title === 'string' && item.title.trim() ? item.title.trim() : fallback.title;
            var displayArtist = typeof item.artist === 'string' && item.artist.trim() ? item.artist.trim() : fallback.artist;
            var artworkUrl = typeof item.artworkUrl === 'string' ? item.artworkUrl.trim() : '';
            var isPlaceholder = item.isPlaceholder === true;

            setText(title, displayTitle, fallback.title);
            setText(artist, displayArtist, fallback.artist);
            status.textContent = isPlaceholder ? 'En directo' : 'Reproduciendo';

            if (!isPlaceholder && artworkUrl) {
              showArtwork(artworkUrl, displayTitle, displayArtist);
            } else {
              showBrand();
            }

            window.__brokawNowPlaying = item;
            document.dispatchEvent(new CustomEvent('brokaw:now-playing', { detail: item }));
          }

          function fetchNowPlaying() {
            var controller = typeof AbortController === 'function' ? new AbortController() : null;
            var timeout = controller ? window.setTimeout(function () {
              controller.abort();
            }, 8000) : null;

            fetch(endpoint, {
              cache: 'no-store',
              signal: controller ? controller.signal : undefined
            })
              .then(function (response) {
                if (!response.ok) throw new Error('Now playing request failed');
                return response.json();
              })
              .then(function (item) {
                if (item && typeof item === 'object') applyNowPlaying(item);
              })
              .catch(function () {
                if (!(title.textContent || '').trim()) applyNowPlaying(fallback);
              })
              .finally(function () {
                if (timeout !== null) window.clearTimeout(timeout);
              });
          }

          root.dataset.nowPlayingBound = 'true';
          fetchNowPlaying();
          window.setInterval(fetchNowPlaying, 45000);
        }

        function initAllNowPlaying() {
          var roots = document.querySelectorAll('[data-now-playing]');
          roots.forEach(initNowPlaying);
        }

        window.__brokawInitNowPlaying = initAllNowPlaying;
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAllNowPlaying);
        } else {
          initAllNowPlaying();
        }
      })();
    </script>
    <script>
      (function () {
        function initAnimatedHighlights() {
          var marks = Array.prototype.slice.call(
            document.querySelectorAll('[data-animated-highlights] mark.spritz-highlight')
          );
          if (!marks.length) return;

          document.documentElement.classList.add('spritz-highlights-ready');

          marks.forEach(function (mark) {
            mark.setAttribute(
              'data-highlight-direction',
              window.getComputedStyle(mark).direction === 'rtl' ? 'rtl' : 'ltr'
            );
          });

          function reveal(target) {
            var targetMarks = target.matches('mark.spritz-highlight')
              ? [target]
              : Array.prototype.slice.call(target.querySelectorAll('mark.spritz-highlight'));

            targetMarks.forEach(function (mark, index) {
              window.setTimeout(function () {
                mark.classList.add('is-highlighted');
              }, index * 90);
            });
          }

          if (
            !('IntersectionObserver' in window) ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            marks.forEach(function (mark) {
              mark.classList.add('is-highlighted');
            });
            return;
          }

          var targets = [];
          marks.forEach(function (mark) {
            var target = mark.closest('p, li, blockquote') || mark;
            if (targets.indexOf(target) === -1) targets.push(target);
          });

          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                reveal(entry.target);
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.2 }
          );

          targets.forEach(function (target) {
            observer.observe(target);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAnimatedHighlights);
        } else {
          initAnimatedHighlights();
        }
      })();
    </script>
    <script>
      (function () {
        if (typeof gtag !== 'function') return;

        /**
          * Scroll depth tracking
          * Tracks when users scroll to certain percentages of the page.
          */
        var scrollMilestones = [25, 50, 75, 100];
        var scrollReached = {};

        function checkScrollDepth() {
          var scrolled = window.scrollY || document.documentElement.scrollTop;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return;
          var pct = Math.min(100, Math.round((scrolled / docHeight) * 100));
          for (var i = 0; i < scrollMilestones.length; i++) {
            var milestone = scrollMilestones[i];
            if (!scrollReached[milestone] && pct >= milestone) {
              scrollReached[milestone] = true;
              gtag('event', 'scroll_depth', { percent_scrolled: milestone });
            }
          }
        }

        window.addEventListener('scroll', checkScrollDepth, { passive: true });
        checkScrollDepth();

        /**
          * Outbound link click tracking
          * Tracks clicks on links that navigate away from the current site.
          */
        document.addEventListener('click', function (e) {
          var target = e.target;
          while (target && target.tagName !== 'A') {
            target = target.parentElement;
          }
          if (!target) return;
          var href = target.getAttribute('href');
          if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0) return;
          try {
            var url = new URL(href, window.location.href);
            if (url.hostname && url.hostname !== window.location.hostname) {
              gtag('event', 'outbound_click', {
                link_url: url.href,
                link_domain: url.hostname,
                link_text: (target.textContent || '').trim().slice(0, 100),
                transport_type: 'beacon'
              });
            }
          } catch (_) {}
        });
      })();
    </script>
