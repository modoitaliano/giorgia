{{#if (eq showImage false)}}
  {{#if category}}
    <div class='flex items-center {{#if metaTextSize}}{{metaTextSize}}{{else}}text-xs{{/if}} mb-2'>
      <span class='text-[#8f0d00] dark:text-[#ff2e1a] uppercase font-bold tracking-wider'>{{category}}</span>
      {{#if readTime}}<span class='mx-2 text-slate-400 dark:text-slate-500'>•</span><span class='article-time text-slate-500 dark:text-slate-400'>{{readTime}}</span>{{/if}}
    </div>
  {{else if (lookup categories 0)}}
    {{#with (lookup categories 0)}}
      <div class='flex items-center {{#if ../metaTextSize}}{{../metaTextSize}}{{else}}text-xs{{/if}} mb-2'>
        <span class='text-[#8f0d00] dark:text-[#ff2e1a] uppercase font-bold tracking-wider'>{{name}}</span>
        {{#if ../readTime}}<span class='mx-2 text-slate-400 dark:text-slate-500'>•</span><span class='article-time text-slate-500 dark:text-slate-400'>{{../readTime}}</span>{{/if}}
      </div>
    {{/with}}
  {{else if readTime}}
    <div class='flex items-center {{#if metaTextSize}}{{metaTextSize}}{{else}}text-xs{{/if}} mb-2'><span class='article-time text-slate-500 dark:text-slate-400'>{{readTime}}</span></div>
  {{/if}}
{{else}}
{{#unless (coalesce image featuredImage.url)}}
{{#if category}}
  <div class='flex items-center {{#if metaTextSize}}{{metaTextSize}}{{else}}text-xs{{/if}} mb-2'>
    <span class='text-[#8f0d00] dark:text-[#ff2e1a] uppercase font-bold tracking-wider'>{{category}}</span>
    {{#if readTime}}
      <span class='mx-2 text-slate-400 dark:text-slate-500'>•</span>
      <span class='article-time text-slate-500 dark:text-slate-400'>{{readTime}}</span>
    {{/if}}
  </div>
{{else if (lookup categories 0)}}
  {{#with (lookup categories 0)}}
    <div class='flex items-center {{#if ../metaTextSize}}{{../metaTextSize}}{{else}}text-xs{{/if}} mb-2'>
      <span class='text-[#8f0d00] dark:text-[#ff2e1a] uppercase font-bold tracking-wider'>{{name}}</span>
      {{#if ../readTime}}
        <span class='mx-2 text-slate-400 dark:text-slate-500'>•</span>
        <span class='article-time text-slate-500 dark:text-slate-400'>{{../readTime}}</span>
      {{/if}}
    </div>
  {{/with}}
{{else if readTime}}
  <div class='flex items-center {{#if metaTextSize}}{{metaTextSize}}{{else}}text-xs{{/if}} mb-2'>
    <span class='article-time text-slate-500 dark:text-slate-400'>{{readTime}}</span>
  </div>
{{/if}}
{{/unless}}
{{/if}}
