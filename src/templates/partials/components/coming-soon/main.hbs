<main class='flex-1 container mx-auto px-4 py-16'>
  <div class='mx-auto max-w-2xl text-center'>
    <div class='mb-8 flex justify-center' aria-hidden='true'>
      <span class='font-label border border-[#ed0076]/35 bg-[#ed0076]/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-[#b00058] dark:text-[#ff78b5]'>Próximamente</span>
    </div>

    <h1 class='headline text-balance text-5xl font-bold uppercase text-slate-900 dark:text-slate-100 sm:text-7xl'>{{title}}</h1>

    <p class='mx-auto mt-6 max-w-xl text-balance text-xl leading-relaxed text-slate-600 dark:text-slate-400'>
      {{#if excerpt}}{{excerpt}}{{else}}Estamos preparando algo especial. Vuelve pronto para descubrirlo.{{/if}}
    </p>

    <a href='{{logoLink}}' class='mt-10 inline-flex items-center gap-2 bg-[#ed0076] px-6 py-3 font-bold text-white transition-colors hover:bg-[#b00058] focus:outline-none focus:ring-2 focus:ring-[#ed0076] focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-slate-950'>
      <span>Volver al inicio</span>
      <svg class='h-4 w-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true'><path d='m9 18 6-6-6-6'></path></svg>
    </a>
  </div>
</main>
