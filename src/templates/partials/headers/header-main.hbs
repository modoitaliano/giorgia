</header>

<script>
  (() => {
    const button = document.getElementById('radio-menu-button');
    const panel = document.getElementById('radio-menu');
    const closeButton = document.getElementById('radio-menu-close');
    if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const setOpen = (open) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      panel.classList.toggle('pointer-events-none', !open);
      panel.classList.toggle('pointer-events-auto', open);
      panel.classList.toggle('opacity-0', !open);
      panel.classList.toggle('opacity-100', open);
      panel.classList.toggle('scale-y-95', !open);
      panel.classList.toggle('scale-y-100', open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    closeButton?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();
</script>

<script>
  (() => {
    const WEATHER_URL = 'https://cdn.fifthbell.com/content/weather-current.json';
    const REFRESH_MS = 60 * 60 * 1000;
    const PHASE_MS = 5 * 1000;
    const WEATHER_CITIES = new Set([
      'new york city',
      'tala',
      'montevideo',
      'santiago',
      'viña del mar',
      'sanremo'
    ]);
    const root = document.querySelector('[data-giorgia-weather-bar]');
    if (!(root instanceof HTMLElement)) return;

    const dateElement = root.querySelector('[data-weather-date]');
    const weatherElement = root.querySelector('[data-weather-current]');
    const iconElement = root.querySelector('[data-weather-icon]');
    const cityElement = root.querySelector('[data-weather-city]');
    const temperatureElement = root.querySelector('[data-weather-temperature]');
    const countryElement = root.querySelector('[data-weather-country]');
    let cities = [];
    let phase = 0;
    let phaseTimer;

    const updateDate = () => {
      if (!(dateElement instanceof HTMLTimeElement)) return;
      const now = new Date();
      dateElement.dateTime = now.toISOString();
      dateElement.textContent = new Intl.DateTimeFormat('es-CL', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(now);
    };

    const countryKey = (city) => String(city?.country || '').trim().toLocaleLowerCase();

    const arrangeCities = (input) => {
      const groups = new Map();
      const order = [];
      input.forEach((city) => {
        const key = countryKey(city);
        if (!key) return;
        if (!groups.has(key)) {
          groups.set(key, []);
          order.push(key);
        }
        groups.get(key).push(city);
      });

      const arranged = [];
      let previous = '';
      while (arranged.length < input.length) {
        const candidates = order
          .filter((key) => groups.get(key)?.length && key !== previous)
          .sort((a, b) => groups.get(b).length - groups.get(a).length);
        const key = candidates[0] || order.find((candidate) => groups.get(candidate)?.length);
        if (!key) break;
        arranged.push(groups.get(key).shift());
        previous = key;
      }

      if (arranged.length > 2 && countryKey(arranged[0]) === countryKey(arranged[arranged.length - 1])) {
        for (let index = 1; index < arranged.length - 1; index += 1) {
          const candidate = arranged[index];
          const last = arranged[arranged.length - 1];
          const before = arranged[index - 1];
          const after = arranged[index + 1];
          const beforeLast = arranged[arranged.length - 2];
          if (
            countryKey(candidate) !== countryKey(arranged[0]) &&
            countryKey(candidate) !== countryKey(beforeLast) &&
            countryKey(last) !== countryKey(before) &&
            countryKey(last) !== countryKey(after)
          ) {
            arranged[index] = last;
            arranged[arranged.length - 1] = candidate;
            break;
          }
        }
      }
      return arranged;
    };

    const iconSvg = (condition) => {
      const common = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
      const icons = {
        sunny: `<svg ${common}><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>`,
        cloudy: `<svg ${common}><path d="M17.5 19H9a7 7 0 1 1 6.7-9h1.8a4.5 4.5 0 1 1 0 9Z"></path></svg>`,
        rainy: `<svg ${common}><path d="M16 13a4 4 0 1 0-3.8-5.2A5 5 0 1 0 6 15h10a4 4 0 0 0 0-8"></path><path d="m8 19-1 2m5-2-1 2m5-2-1 2"></path></svg>`,
        windy: `<svg ${common}><path d="M3 8h10a2 2 0 1 0-2-2M3 12h15a2 2 0 1 1-2 2M3 16h8"></path></svg>`
      };
      return icons[condition] || icons.cloudy;
    };

    const renderWeather = () => {
      if (!(weatherElement instanceof HTMLElement) || cities.length === 0) return;
      const city = cities[phase % cities.length];
      const fahrenheit = Number(city.temp);
      const temperature = Math.round((fahrenheit - 32) * 5 / 9);
      cityElement.textContent = city.name || '';
      countryElement.textContent = city.country || '';
      temperatureElement.textContent = `${temperature}°C`;
      iconElement.innerHTML = iconSvg(city.condition);
      weatherElement.hidden = false;
      weatherElement.dataset.weatherCity = city.name || '';
      weatherElement.dataset.weatherCountry = city.country || '';
      weatherElement.dataset.weatherUnit = 'celsius';
      weatherElement.classList.remove('radio-weather-swap');
      void weatherElement.offsetWidth;
      weatherElement.classList.add('radio-weather-swap');
    };

    const setWeather = (payload) => {
      if (!Array.isArray(payload?.cities)) return;
      const valid = payload.cities.filter(
        (city) =>
          city &&
          city.name &&
          city.country &&
          WEATHER_CITIES.has(String(city.name).trim().toLocaleLowerCase()) &&
          Number.isFinite(Number(city.temp))
      );
      cities = arrangeCities(valid);
      root.dataset.weatherSequence = cities.map((city) => city.country).join('|');
      root.dataset.weatherCities = cities.map((city) => city.name).join('|');
      phase = 0;
      renderWeather();
      window.clearInterval(phaseTimer);
      if (cities.length) {
        phaseTimer = window.setInterval(() => {
          phase += 1;
          renderWeather();
        }, PHASE_MS);
      }
    };

    const refreshWeather = async () => {
      try {
        const response = await fetch(`${WEATHER_URL}?v=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) throw new Error(`Weather request failed with HTTP ${response.status}`);
        const payload = await response.json();
        window.modoItalianoWeather = payload;
        window.dispatchEvent(new CustomEvent('modoitaliano:weather', { detail: payload }));
      } catch (error) {
        console.error('Failed to refresh weather data:', error);
      }
    };

    window.addEventListener('modoitaliano:weather', (event) => setWeather(event.detail));
    updateDate();
    window.setInterval(updateDate, 60 * 1000);
    void refreshWeather();
    window.setInterval(refreshWeather, REFRESH_MS);
  })();
</script>

<script>
  (() => {
    const slides = [...document.querySelectorAll('[data-radio-slide]')];
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let activeSlide = 0;
    window.setInterval(() => {
      slides[activeSlide].style.opacity = '0';
      slides[activeSlide].classList.remove('is-active');
      activeSlide = (activeSlide + 1) % slides.length;
      slides[activeSlide].style.opacity = '1';
      slides[activeSlide].classList.add('is-active');
    }, 6500);
  })();
</script>
