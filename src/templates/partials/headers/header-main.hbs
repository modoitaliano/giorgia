    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/11/compressed_dsc03438-91d37874-cc48-40df-91ef-25ed7cf10531.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/11/compressed_dsc03530-e2afbb0a-a55d-48a6-803b-42f2d2f06f05.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/11/compressed_dsc03559-9b3b796a-cff6-41a9-8f17-5f5f309fe2ae.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/11/compressed_dsc03615-b9a8d46d-c533-4481-a58b-3b89421cae7a.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc01713-8a4dbf77-00ba-4045-9b45-32a2fd9f77ae.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc01759-3eebe4ca-f7de-4316-ae44-a5920be4f960.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc01836-2d771594-6a55-4ea7-9fec-33ca190bee67.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc06730-fda567cd-350a-40d8-bccd-1e75429d82fa.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc05911-c0b81f38-f613-46a5-9a94-9fccd5a934f9.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc02290-cdb90e9f-669d-4401-86f9-e884e513eda8.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div data-radio-slide class='absolute inset-0 scale-105 bg-cover bg-center blur-[2px]' style='background-image: url(https://macondostack-alcantara-assets.s3.amazonaws.com/artwork/2026/04/24/compressed_dsc01841-c370f4d2-c738-4786-9bb0-263b6d0ab0f2.avif); opacity: 0; transition: opacity 1200ms ease-in-out;'></div>
    <div
      class='absolute inset-0'
      style='background: rgba(10, 18, 52, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);'
    ></div>
  </div>

  <div class='relative mx-auto h-full max-w-6xl px-9 pt-10.25'>
    <div class='grid grid-cols-[1fr_auto_1fr] items-start'>
      <button
        id='radio-menu-button'
        class='mt-4.75 inline-flex h-7 w-7 items-center justify-center text-white transition hover:opacity-70 focus:outline-none focus:ring-2 focus:ring-white'
        type='button'
        aria-label='Abrir menú de navegación'
        aria-expanded='false'
        aria-controls='radio-menu'
      >
        <span class='flex w-5.25 flex-col gap-1.25' aria-hidden='true'>
          <span class='h-0.5 w-full bg-white'></span>
          <span class='h-0.5 w-full bg-white'></span>
        </span>
      </button>

      <a href='{{logoLink}}' class='mt-3 block h-12 w-34.5 focus:outline-none focus:ring-2 focus:ring-white' aria-label='MI home'>
        <img src='{{coalesce logoAssetUrl "https://cdn.modoitaliano.fm/assets/mi.svg"}}' alt='MI' class='h-full w-full object-contain' />
      </a>

      <a href='{{#if (eq language "en")}}/search{{else}}/{{language}}/search{{/if}}' class='mt-4.5 justify-self-end p-1 text-white/85 transition hover:text-white focus:outline-none focus:ring-2 focus:ring-white' aria-label='Buscar'>
        <svg class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true'><circle cx='11' cy='11' r='7'></circle><path d='m20 20-4-4'></path></svg>
      </a>
    </div>

    <nav class='radio-navigation absolute inset-x-9 top-35.75 hidden justify-center gap-x-10 text-base font-bold uppercase leading-5 lg:flex' style='font-weight: 700;' aria-label='Navegación principal'>
      {{#each (slice navigation.categories 0 6)}}
        <a href='/{{slug}}' class='whitespace-nowrap transition hover:text-white/65 focus:outline-none focus:underline'>{{name}}</a>
      {{/each}}
    </nav>

    <div id='radio-menu' class='pointer-events-none absolute inset-x-9 top-25.75 z-[70] origin-top scale-y-95 rounded-sm bg-[#b00058]/95 p-7 opacity-0 shadow-2xl backdrop-blur-md transition duration-200' hidden>
      <div class='flex items-center justify-between border-b border-white/30 pb-4'>
        <p class='text-xs font-bold uppercase tracking-[0.18em]'>Explora ModoItaliano</p>
        <button id='radio-menu-close' class='p-1 focus:outline-none focus:ring-2 focus:ring-white' type='button' aria-label='Cerrar menú de navegación'>
          <svg class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true'><path d='M6 6l12 12M18 6 6 18'></path></svg>
        </button>
      </div>
      <nav class='grid grid-cols-2 gap-x-6 gap-y-4 pt-5 sm:grid-cols-3' aria-label='Todas las secciones'>
        <a href='{{logoLink}}' class='text-sm font-bold transition hover:text-white/65'>Noticias destacadas</a>
        {{#each navigation.categories}}
          <a href='/{{slug}}' class='text-sm font-bold transition hover:text-white/65'>{{name}}</a>
        {{/each}}
      </nav>
    </div>

    <section
      class='absolute left-1/2 top-35.75 z-60 h-72.5 w-72.5 -translate-x-1/2 overflow-hidden bg-[#312d2e] lg:top-51.25'
      style='border-radius: 14px; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.34);'
      aria-label='Reproduciendo ahora'
      data-now-playing
      data-now-playing-endpoint='https://cdn.modoitaliano.fm/content/now-playing.json'
    >
      <div class='relative h-full w-full overflow-hidden'>
        <div data-now-playing-brand class='absolute inset-0 flex items-center justify-center bg-[#312d2e]'>
          <div class='absolute inset-0 bg-[#ed0076]/35'></div>
          <div class='absolute inset-0' style='background: radial-gradient(circle at 50% 35%, rgba(255,255,255,0.18), transparent 34%), linear-gradient(135deg, rgba(10,18,52,0.72), rgba(237,0,118,0.58));'></div>
          <img src='{{coalesce logoAssetUrl "https://cdn.modoitaliano.fm/assets/mi.svg"}}' alt='' class='relative h-23 w-54 object-contain opacity-95' aria-hidden='true' />
        </div>
        <img data-now-playing-artwork alt='' class='hidden h-full w-full object-cover' />
        <div class='absolute inset-x-0 bottom-0 h-[42%] bg-linear-to-t from-black/80 to-transparent'></div>
        <div class='absolute bottom-3.75 left-3.75 right-16.25'>
          <p class='flex items-center gap-2 text-[10px] font-bold uppercase tracking-wide text-white/80'><span class='h-2 w-2 rounded-full bg-cyan-300'></span><span data-now-playing-status>En directo</span></p>
          <h2 data-now-playing-title class='radio-display mt-1 line-clamp-1 text-2xl font-semibold uppercase leading-none tracking-[0.02em] text-white'>ModoItaliano</h2>
          <p data-now-playing-artist class='radio-display mt-1 line-clamp-1 text-xl font-medium uppercase leading-none tracking-[0.02em] text-white/85'>Live radio</p>
        </div>
        <button
          class='absolute bottom-3.5 right-3.5 flex h-12 w-12 items-center justify-center text-white transition hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#312d2e]'
          style='border: 2px solid rgba(255, 255, 255, 0.82); border-radius: 9999px; background: linear-gradient(145deg, #ff3c9d, #ed0076); box-shadow: 0 5px 14px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.36);'
          type='button'
          aria-label='Reproducir selección actual'
        >
          <svg class='ml-0.5 h-5 w-5' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'><path d='M8 5.5a1 1 0 0 1 1.52-.86l9 6.5a1 1 0 0 1 0 1.72l-9 6.5A1 1 0 0 1 8 18.5v-13Z'></path></svg>
        </button>
      </div>
    </section>
  </div>
</header>

<script>
  (() => {
    const button = document.getElementById('radio-menu-button');
    const panel = document.getElementById('radio-menu');
    const closeButton = document.getElementById('radio-menu-close');
    if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const setOpen = (open) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      panel.classList.toggle('pointer-events-none', !open);
      panel.classList.toggle('pointer-events-auto', open);
      panel.classList.toggle('opacity-0', !open);
      panel.classList.toggle('opacity-100', open);
      panel.classList.toggle('scale-y-95', !open);
      panel.classList.toggle('scale-y-100', open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    closeButton?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();
</script>

<script>
  (() => {
    const root = document.querySelector('[data-now-playing]');
    if (!(root instanceof HTMLElement)) return;

    const endpoint = root.dataset.nowPlayingEndpoint;
    const artwork = root.querySelector('[data-now-playing-artwork]');
    const brand = root.querySelector('[data-now-playing-brand]');
    const status = root.querySelector('[data-now-playing-status]');
    const title = root.querySelector('[data-now-playing-title]');
    const artist = root.querySelector('[data-now-playing-artist]');
    if (!endpoint || !(artwork instanceof HTMLImageElement) || !(brand instanceof HTMLElement) || !(status instanceof HTMLElement) || !(title instanceof HTMLElement) || !(artist instanceof HTMLElement)) return;

    const fallback = {
      title: title.textContent?.trim() || 'ModoItaliano',
      artist: artist.textContent?.trim() || 'Live radio',
      isPlaceholder: true
    };

    const setText = (element, value, fallbackValue) => {
      element.textContent = typeof value === 'string' && value.trim() ? value.trim() : fallbackValue;
    };

    const showBrand = () => {
      brand.classList.remove('hidden');
      artwork.classList.add('hidden');
      artwork.removeAttribute('src');
      artwork.alt = '';
    };

    const showArtwork = (url, itemTitle, itemArtist) => {
      artwork.src = url;
      artwork.alt = [itemTitle, itemArtist].filter(Boolean).join(' by ');
      artwork.classList.remove('hidden');
      brand.classList.add('hidden');
    };

    const applyNowPlaying = (item) => {
      const displayTitle = typeof item.title === 'string' && item.title.trim() ? item.title.trim() : fallback.title;
      const displayArtist = typeof item.artist === 'string' && item.artist.trim() ? item.artist.trim() : fallback.artist;
      const artworkUrl = typeof item.artworkUrl === 'string' ? item.artworkUrl.trim() : '';
      const isPlaceholder = item.isPlaceholder === true;

      setText(title, displayTitle, fallback.title);
      setText(artist, displayArtist, fallback.artist);
      status.textContent = isPlaceholder ? 'En directo' : 'Reproduciendo';

      if (!isPlaceholder && artworkUrl) {
        showArtwork(artworkUrl, displayTitle, displayArtist);
      } else {
        showBrand();
      }
    };

    const fetchNowPlaying = async () => {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 8000);
      try {
        const response = await fetch(endpoint, { cache: 'no-store', signal: controller.signal });
        if (!response.ok) throw new Error('Now playing request failed');
        const item = await response.json();
        if (item && typeof item === 'object') applyNowPlaying(item);
      } catch {
        if (!title.textContent?.trim()) applyNowPlaying(fallback);
      } finally {
        window.clearTimeout(timeout);
      }
    };

    fetchNowPlaying();
    window.setInterval(fetchNowPlaying, 45000);
  })();
</script>

<script>
  (() => {
    const slides = [...document.querySelectorAll('[data-radio-slide]')];
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let activeSlide = 0;
    window.setInterval(() => {
      slides[activeSlide].style.opacity = '0';
      slides[activeSlide].classList.remove('is-active');
      activeSlide = (activeSlide + 1) % slides.length;
      slides[activeSlide].style.opacity = '1';
      slides[activeSlide].classList.add('is-active');
    }, 6500);
  })();
</script>
