<style>
  @keyframes radio-header-ken-burns {
    from { transform: scale(1.04); }
    to { transform: scale(1.12); }
  }

  [data-radio-slide] {
    background-position: center center;
    transform-origin: center center;
  }

  [data-radio-slide].is-active {
    animation: radio-header-ken-burns 6500ms ease-out both;
  }

  .radio-header {
    font-family: 'Outfit', system-ui, sans-serif;
  }

  .radio-header .radio-display {
    font-family: 'Barlow Condensed', system-ui, sans-serif;
  }

  .radio-header .radio-navigation {
    font-family: 'Barlow', system-ui, sans-serif;
  }

  .radio-weather-bar {
    background: linear-gradient(90deg, rgba(10, 18, 52, 0.78), rgba(49, 45, 46, 0.4));
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    border-top: 2px solid #ed0076;
    box-shadow: inset 0 -1px rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .radio-weather-date {
    color: rgba(255, 255, 255, 0.7);
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: 0.08em;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .radio-weather-current {
    align-items: center;
    display: flex;
    gap: 0.625rem;
    justify-content: flex-end;
    min-width: 0;
  }

  .radio-weather-current[hidden] { display: none; }

  .radio-weather-icon {
    color: #67e8f9;
    display: inline-flex;
    filter: drop-shadow(0 0 7px rgba(103, 232, 249, 0.3));
  }

  .radio-weather-icon svg { height: 1.125rem; width: 1.125rem; }

  .radio-weather-city,
  .radio-weather-temperature,
  .radio-weather-country {
    font-family: 'Barlow Condensed', system-ui, sans-serif;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .radio-weather-city {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    max-width: 12rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .radio-weather-temperature {
    background: #ed0076;
    border-radius: 999px;
    box-shadow: 0 3px 10px rgba(237, 0, 118, 0.28);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    letter-spacing: 0.025em;
    line-height: 1;
    padding: 0.3rem 0.5rem;
  }

  .radio-weather-country {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .radio-weather-swap { animation: radio-weather-swap 320ms ease-out; }

  @keyframes radio-weather-swap {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .radio-now-playing-swap { animation: radio-now-playing-swap 420ms ease-out; }

  @keyframes radio-now-playing-swap {
    from { opacity: 0; transform: translateY(8px) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-radio-slide].is-active { animation: none; transform: scale(1.05); }
    .radio-weather-swap { animation: none; }
    .radio-now-playing-swap { animation: none; }
  }

  @media (max-width: 639px) {
    .radio-weather-country { display: none; }
    .radio-weather-city { max-width: 7.5rem; }
  }
</style>

<header class='radio-header relative z-50 isolate h-[424px] overflow-visible bg-[#ed0076] text-white lg:h-[494px]' style='view-transition-name: site-header;'>
  <div class='absolute inset-0 overflow-hidden' aria-hidden='true'>
