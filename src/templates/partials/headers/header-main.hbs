<style>
  @keyframes radio-header-ken-burns {
    from { transform: scale(1.04); }
    to { transform: scale(1.12); }
  }

  [data-radio-slide] {
    background-position: center center;
    transform-origin: center center;
  }

  [data-radio-slide].is-active {
    animation: radio-header-ken-burns 6500ms ease-out both;
  }

  .radio-header {
    font-family: 'Outfit', system-ui, sans-serif;
  }

  .radio-header .radio-display {
    font-family: 'Barlow Condensed', system-ui, sans-serif;
  }

  .radio-header .radio-navigation {
    font-family: 'Barlow', system-ui, sans-serif;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-radio-slide].is-active { animation: none; transform: scale(1.05); }
  }
</style>

